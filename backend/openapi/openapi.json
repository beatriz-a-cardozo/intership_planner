{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "API de planejamento financeiro e de intercâmbio. Autentique em /api/auth/login e use o accessToken como Bearer.",
    "title" : "Interchange Planner API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Autentica com e-mail e senha",
        "tags" : [ "Autenticação" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Encerra a sessão atual",
        "tags" : [ "Autenticação" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Renova o access token usando o cookie de refresh (rotativo)",
        "tags" : [ "Autenticação" ]
      }
    },
    "/api/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Cria uma conta e já inicia a sessão",
        "tags" : [ "Autenticação" ]
      }
    },
    "/api/currencies" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CurrencyResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Lista as moedas suportadas",
        "tags" : [ "Moedas" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Dados do usuário autenticado",
        "tags" : [ "Usuário" ]
      }
    },
    "/api/me/settings" : {
      "get" : {
        "operationId" : "settings",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserSettingsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Preferências do usuário autenticado",
        "tags" : [ "Usuário" ]
      },
      "put" : {
        "operationId" : "updateSettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateSettingsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserSettingsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Atualiza preferências (tema, idioma, fuso, moedas)",
        "tags" : [ "Usuário" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "tokenType" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/MeResponse"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType", "user" ]
      },
      "CurrencyResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "scale" : {
            "type" : "integer",
            "format" : "int32"
          },
          "symbol" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "name", "scale", "symbol" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "onboardingCompleted" : {
            "type" : "boolean"
          },
          "settings" : {
            "$ref" : "#/components/schemas/UserSettingsResponse"
          }
        },
        "required" : [ "displayName", "email", "id", "onboardingCompleted", "settings" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 2
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8,
            "pattern" : "^(?=.*[A-Za-z])(?=.*[0-9]).+$"
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "UpdateSettingsRequest" : {
        "type" : "object",
        "properties" : {
          "locale" : {
            "type" : "string",
            "maxLength" : 10,
            "minLength" : 0
          },
          "primaryCurrency" : {
            "type" : "string",
            "pattern" : "[A-Z]{3}"
          },
          "secondaryCurrency" : {
            "type" : "string",
            "pattern" : "[A-Z]{3}"
          },
          "theme" : {
            "type" : "string",
            "enum" : [ "LIGHT", "DARK", "SYSTEM" ]
          },
          "timezone" : {
            "type" : "string",
            "maxLength" : 60,
            "minLength" : 0
          }
        },
        "required" : [ "locale", "primaryCurrency", "secondaryCurrency", "theme", "timezone" ]
      },
      "UserSettingsResponse" : {
        "type" : "object",
        "properties" : {
          "locale" : {
            "type" : "string"
          },
          "primaryCurrency" : {
            "type" : "string"
          },
          "secondaryCurrency" : {
            "type" : "string"
          },
          "theme" : {
            "type" : "string",
            "enum" : [ "LIGHT", "DARK", "SYSTEM" ]
          },
          "timezone" : {
            "type" : "string"
          }
        },
        "required" : [ "locale", "primaryCurrency", "secondaryCurrency", "theme", "timezone" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
