# Copie para .env (nunca versionado) e ajuste.

# Nome do produto (backend e frontend)
APP_NAME=Interchange Planner

# Banco
DB_NAME=interchange_planner
DB_USERNAME=interchange
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Chave do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Cookie de refresh com flag Secure. false só para http://localhost; em produção (HTTPS) use true.
REFRESH_COOKIE_SECURE=false

# Origens extras liberadas no CORS (separadas por vírgula). Vazio = mesmo domínio via proxy.
APP_CORS_ALLOWED_ORIGINS=

# Portas publicadas no host
BACKEND_PORT=8080
FRONTEND_PORT=8081
